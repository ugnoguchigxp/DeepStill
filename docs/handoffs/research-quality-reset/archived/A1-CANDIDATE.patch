new file mode 100644
index 0000000..32705e7
--- /dev/null
+++ b/packages/research/action-repair.ts
@@ -0,0 +1,22 @@
+/** Runtime feedback, not instructions copied from a source or model response. */
+export function actionRepairMessage(code: string): string {
+	if (code.includes("WITHHELD"))
+		return "拒否された資料は別名でも取得できません。独立した未試行資料か新しい検索を選んでください。";
+	if (code.includes("URL_ALREADY_ATTEMPTED"))
+		return "このURLは取得を試行済みです。表示された未試行のリンクか、新しい具体的な検索を選んでください。";
+	if (code.includes("SOURCE_ALREADY_READ"))
+		return "この資料は既読です。readableSourceIdsの資料、未試行リンク、または新しい検索を選んでください。";
+	if (code.includes("QUERY_ALREADY_SEARCHED"))
+		return "この検索は実行済みです。未解決の問いを別の具体的な表現で検索するか、未試行リンクを選んでください。";
+	if (code.includes("UNRESOLVED_REQUEST"))
+		return "重要な問いが未解決です。追加の有用な経路を選び、経路がなければ未充足の理由で終了してください。";
+	return "行動は実行していません。現在の候補・未読資料・残予算から有効な次の行動だけを選んでください。";
+}
+
+export interface ActionFeedback {
+	code: string;
+	failedAction: unknown;
+	executed: false;
+	draftSaved: boolean;
+	message: string;
+}
