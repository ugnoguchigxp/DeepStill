+	"commit-failure",
+])("local navigation repair: %s", async (mode) => {
+	const dir = mkdtempSync(join(tmpdir(), "action-repair-"));
+	const store = new Store(join(dir, "test.db"));
+	store.migrate();
+	const job = store.create(
+		createJobSchema.parse({
+			topic: "圧縮の仕組み",
+			budget: { tokens: 500000 },
+		}),
+	);
+	job.config.researchFlow = "deliverables-v1";
+	if (mode === "legacy") delete job.config.deliveryRecoveryVersion;
+	if (mode === "total-limit") job.config.totalNavigationRepairLimit = 1;
+	store.saveJob(job);
+	let crashed = false;
+	const originalCommit = store.commit.bind(store);
+	store.commit = (task, fn, payload, done, delay) => {
+		if (
+			mode === "commit-failure" &&
+			!crashed &&
+			typeof payload === "object" &&
+			payload !== null &&
+			"actionFeedback" in payload &&
+			payload.actionFeedback
+		) {
+			crashed = true;
+			return originalCommit(
+				task,
+				() => {
+					fn();
+					throw new LeaseLost();
+				},
+				payload,
+				done,
+				delay,
+			);
+		}
+		return originalCommit(task, fn, payload, done, delay);
+	};
+	let repairs = 0;
+	let writes = 0;
+	let crawls = 0;
+	let repairVersion: number | undefined;
+	try {
+		for (
+			let step = 0;
+			step < 45 && !terminal(store.getJob(job.id)?.status ?? "");
+			step++
+		) {
+			// New engine on every tick exercises persisted Flow rather than in-memory state.
+			const engine = new Engine(
+				store,
+				() => ({
+					...mocks,
+					crawler: {
+						...mocks.crawler,
+						async crawl(url, signal) {
+							crawls++;
+							return mocks.crawler.crawl(url, signal);
+						},
+					},
+					llm: {
+						async complete(kind, input) {
+							const data = JSON.parse(input);
+							if (kind === "deliverable_episode")
+								return {
+									text: JSON.stringify({
+										title: "調査",
+										context: "試験",
+										intent: job.topic,
+										observations: "実行記録",
+										decisions: [],
+										actionTaken: "読解と訂正",
+										outcome: data.reason,
+										outcomeKind: data.satisfied ? "success" : "failure",
+										failedApproach: [],
+										lesson: "既読の再取得を避ける",
+										triggers: [],
+										openLoops: [],
+									}),
+									usage: 100,
+									audit: {},
+								};
+							const repeat = {
+								kind: "fetch",
+								url: data.sources[0]?.url,
+								purpose: "測定条件を確認",
+							};
+							if (kind === "deliverable_navigation_repair") {
+								repairs++;
+								expect(data.draft).toBeUndefined();
+								expect(data.newContent).toBeNull();
+								expect(data.actionFeedback.executed).toBe(false);
+								expect(data.actionFeedback.draftSaved).toBe(true);
+								expect(data.actionFeedback.message).toBeTruthy();
+								const artifacts = store.detail(job.id)?.artifacts ?? [];
+								expect(artifacts).toHaveLength(1);
+								expect(artifacts[0].claimIds.length).toBeGreaterThan(0);
+								repairVersion ??= artifacts[0].version;
+								expect(artifacts[0].version).toBe(repairVersion);
+								return {
+									text: JSON.stringify({
+										draft: null,
+										next:
+											repairs === 1 || mode === "limit"
+												? repeat
+												: {
+														kind: "finish",
+														satisfied: true,
+														reason: "根拠を保存済み",
+													},
+									}),
+									usage: 100,
+									audit: {},
+								};
+							}
+							if (data.newContent) {
+								writes++;
+								const line = data.newContent.lines[0];
+								return {
+									text: JSON.stringify({
+										draft: {
+											sections: [
+												{
+													title: "説明",
+													paragraphs: [
+														{
+															text: line.text,
+															kind: "finding",
+															citations: [
+																{
+																	sourceId: data.newContent.sourceId,
+																	firstLine:
+																		mode === "invalid-draft"
+																			? 99999
+																			: line.number,
+																	lastLine: line.number,
+																},
+															],
+														},
+													],
+												},
+											],
+											knowledge: [],
+											limitations: [],
+											openQuestions: [],
+										},
+										next:
+											mode === "invalid-action-shape"
+												? { kind: "unknown" }
+												: repeat,
+									}),
+									usage: 100,
+									truncated: mode === "truncated",
+									audit: {},
+								};
+							}
+							return {
+								text: JSON.stringify({
+									draft: null,
+									next: data.validationError
+										? repeat
+										: {
+												kind: "fetch",
+												url: data.discoveries[0].url,
+												purpose: "根拠を読む",
+											},
+								}),
+								usage: 100,
+								audit: {},
+							};
+						},
+					},
+				}),
+				join(dir, "out"),
+			);
+			await engine.tick(job.id);
+			if (crashed)
+				store.sql
+					.query(
+						"UPDATE tasks SET lease_until=0 WHERE job_id=? AND state='running'",
+					)
+					.run(job.id);
+		}
+		const saved = store.getJob(job.id);
+		if (!saved) throw Error("Missing test job");
+		expect(crawls).toBe(1);
+		if (mode === "commit-failure") expect(crashed).toBe(true);
+		if (["invalid-draft", "truncated", "legacy"].includes(mode)) {
+			expect(saved.reason).toBe("invalid_deliverable");
+			expect(repairs).toBe(0);
+			expect(store.detail(job.id)?.claims).toHaveLength(0);
+		} else {
+			expect(writes).toBe(1);
+			expect(repairs).toBe(mode === "total-limit" ? 1 : 2);
+			expect(saved.reason).toBe(
+				["limit", "total-limit"].includes(mode)
+					? "navigation_recovery_limit"
+					: "satisfied",
+			);
+			expect(
+				store.events(job.id).filter((e) => e.type === "deliverable.updated"),
+			).toHaveLength(1);
+		}
+	} finally {
+		store.close();
+		rmSync(dir, { recursive: true, force: true });
+	}
+});
+
+test("repair uses a null draft schema and its own short action contract", () => {
+	const input = JSON.stringify({ readableSourceIds: [] });
+	const schema = groundedSchema("deliverable_navigation_repair", input);
+	const serialized = JSON.stringify(schema);
+	expect(serialized).toContain('"draft":{"type":"null"}');
+	expect(serialized).not.toContain('"const":"read"');
+	const invocation = prompt("deliverable_navigation_repair", input);
+	expect(invocation.system).toContain("do not rewrite");
+	expect(invocation.system).not.toContain(
+		"Draft is the complete current deliverable",
+	);
+});
+
+test("compatible provider preserves usage and marks even valid JSON as truncated", async () => {
+	const request = (async () =>
+		Response.json({
+			choices: [
+				{
+					message: {
+						content:
+							'{"draft":null,"next":{"kind":"finish","satisfied":true,"reason":"done"}}',
+					},
+					finish_reason: "length",
+				},
+			],
+			usage: { total_tokens: 123, prompt_tokens: 100, completion_tokens: 23 },
+		})) as typeof fetch;
+	const llm = new CompatibleLlm(
+		"http://fixture.invalid",
+		"fixture",
+		"",
+		request,
+	);
+	const result = await llm.complete(
+		"deliverable_navigation_repair",
+		"{}",
+		new AbortController().signal,
