HOST=127.0.0.1
PORT=4310
DATABASE_URL=data/deepstill.sqlite
# Live jobs require explicit UI selection.
# Codex option: LLM_PROVIDER=codex and SEARCH_PROVIDER=codex; run codex login.
# Codex uses gpt-5.6-luna with reasoning low. Subscription usage is not a USD price.
LLM_PROVIDER=compatible
SEARCH_PROVIDER=dataforseo
# Optional CLI path when codex is not on PATH.
CODEX_PATH=
# DataForSEO credentials for SEARCH_PROVIDER=dataforseo.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2392
DATAFORSEO_LANGUAGE_CODE=ja
# Conservative per-request USD reservation. Set against your contract/pricing.
DATAFORSEO_MAX_REQUEST_USD=0.10
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=
# Optional explicit ContextStill MCP endpoint; never reads its DB.
CONTEXTSTILL_MCP_URL=
CONTEXTSTILL_API_KEY=
CONTEXTSTILL_PROJECT_REF=
CONTEXTSTILL_REPO_KEY=
CONTEXTSTILL_REPO_PATH=
